# ─────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/pinacleluxe?retryWrites=true&w=majority

# ─────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# Cloudinary (Image Uploads)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─────────────────────────────────────────────
# SendGrid (Email Service)
# ─────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_verified_sender@example.com

# ─────────────────────────────────────────────
# NodeMailer / SMTP (Alternative Email via Gmail)
# Use an App Password, not your actual Gmail password.
# https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_specific_password

# ─────────────────────────────────────────────
# Redis Cache
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# CORS — Allowed Origins (comma-separated)
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
